{
  "name": "arki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:boundaries": "depcruise src tools --config .dependency-cruiser.cjs",
    "lint": "npm run lint:eslint && npm run lint:boundaries",
    "typecheck": "tsc --noEmit",
    "test:boundaries": "vitest run --config vitest.boundaries.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/shared/supabase/database.types.ts && prettier --write src/shared/supabase/database.types.ts",
    "db:types:check": "npm run db:types && git diff --exit-code src/shared/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1",
    "@tanstack/react-query": "^5.108.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.1",
    "supabase": "^2.15.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^5.1.1"
  }
}
